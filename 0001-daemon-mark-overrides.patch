diff -Nurp a/src/amule.h b/src/amule.h
--- a/src/amule.h	2026-09-21 12:05:20.000000000 +0200
+++ b/src/amule.h	2026-10-19 07:27:14.631923770 +0200
@@ -683,13 +683,13 @@ protected:
 class CamuleGuiApp : public CamuleApp, public CamuleGuiBase
 {
 
-	virtual int InitGui(bool geometry_enable, wxString &geometry_string);
-	// No `override`: this class declares none, and adding the first one
-	// turns -Winconsistent-missing-override into errors on every sibling.
-	virtual void RestoreSearchTabs() { CreateRestoredSearchTabs(); }
+	virtual int InitGui(bool geometry_enable, wxString &geometry_string) override;
+	// wxDECLARE_EVENT_TABLE() marks GetEventTable override, so every other
+	// override in this class needs the keyword or clang -Werror=inconsistent-missing-override fails.
+	virtual void RestoreSearchTabs() override { CreateRestoredSearchTabs(); }
 
-	int OnExit();
-	bool OnInit();
+	int OnExit() override;
+	bool OnInit() override;
 
 	// Catch alternate quit paths (macOS Dock right-click → Quit)
 	// so we can run ShutDown cleanup even when wxApp skips OnExit.
@@ -714,7 +714,7 @@ class CamuleGuiApp : public CamuleApp, p
 #endif
 
 public:
-	virtual int ShowAlert(wxString msg, wxString title, int flags);
+	virtual int ShowAlert(wxString msg, wxString title, int flags) override;
 
 	void ShutDown(wxCloseEvent &evt);
 
@@ -740,20 +740,20 @@ extern CamuleGuiApp *theApp;
 class CamuleDaemonApp : public CamuleApp
 {
 private:
-	bool OnInit();
-	int OnRun();
-	int OnExit();
+	bool OnInit() override;
+	int OnRun() override;
+	int OnExit() override;
 
-	virtual int InitGui(bool geometry_enable, wxString &geometry_string);
+	virtual int InitGui(bool geometry_enable, wxString &geometry_string) override;
 	// wxApp::Initialize() sets the file name conversion properly, but
 	// wxAppConsole::Initialize() leaves wxConvFileName as wxConvLibc, on which amuled aborts
 	// for the non-ASCII file names monolithic amule handles. This override sets it.
-	virtual bool Initialize(int &argc_, wxChar **argv_);
+	virtual bool Initialize(int &argc_, wxChar **argv_) override;
 
 public:
 	bool CopyTextToClipboard(wxString strText);
 
-	virtual int ShowAlert(wxString msg, wxString title, int flags);
+	virtual int ShowAlert(wxString msg, wxString title, int flags) override;
 
 	wxDECLARE_EVENT_TABLE();
 };
